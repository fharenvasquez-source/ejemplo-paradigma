        <mxCell id="GCB9a03lHLPF7pWS_mRG-75" value="&lt;ul&gt;&lt;li&gt;Clase persona es la clase base, con todos las caracteristicas de un login y metodo de verificar contraseña, las clases que heradan son administrador y cliente.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="940" y="170" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="GCB9a03lHLPF7pWS_mRG-77" value="&amp;nbsp;Cliente hace un carrito, luego el carrito se compone de varios itemsCarrito, por si se borra el carrito tambien se borraran todos los itemsCarrito dentro de el.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Misma logica para Compra/ItemCompra (registrar compras a proveedores y subir inventario), factura/itemFactura para la venta al cliente&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="970" y="300" width="180" height="180" as="geometry" />
        </mxCell>
        <mxCell id="GCB9a03lHLPF7pWS_mRG-79" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;La forma en la que se asocia:&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Producto se relaciona con categoria y proveedor, porque un producto pertenece a una categoria y viene de un proveedor.&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="970" y="480" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="GCB9a03lHLPF7pWS_mRG-80" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font size=&quot;3&quot;&gt;Simbolos:&lt;/font&gt;&lt;/h1&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;(-) atributos privados que se exponen mediante metodos&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: medium; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(+).&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="960" y="632" width="180" height="120" as="geometry" />
        </mxCell>
